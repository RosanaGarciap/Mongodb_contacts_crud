### ==========================================
### PRUEBA DE PUT (Actualizar contacto)
### Retorna estatus 204 (No Content)
### ==========================================
PUT http://localhost:8080/contacts/6ac108e887fc73a4a483e877
Content-Type: application/json

{
    "firstName": "Carlos",
    "lastName": "Mendoza",
    "email": "carlos.mendoza@example.com",
    "favoriteColor": "Purple",
    "birthday": "1998-11-06"
}

### ==========================================
### PRUEBA DE DELETE (Eliminar contacto)
### Retorna estatus 200 (OK)
### ==========================================
DELETE http://localhost:8080/contacts/6ac108bb87fc73a4a483e876

